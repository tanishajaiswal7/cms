# ==========================================
# Backend Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/cms_production

# JWT Configuration
JWT_SECRET=your-long-random-jwt-secret-key-change-this-in-production
REFRESH_SECRET=your-long-random-refresh-secret-key-change-this-in-production

# Email Configuration (for password reset)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-app-password

# Twilio Configuration (for WhatsApp notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# CORS Configuration
CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# File Upload Configuration
MAX_FILE_SIZE=5242880

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# ==========================================
# IMPORTANT SECURITY NOTES:
# ==========================================
# 1. Never commit your actual .env file to git
# 2. Use strong, random values for JWT_SECRET and REFRESH_SECRET
# 3. Keep STRIPE_WEBHOOK_SECRET and TWILIO_AUTH_TOKEN secure
# 4. Use environment variable management tools in production (AWS Secrets Manager, Azure Key Vault, etc.)
# 5. Rotate credentials regularly
# 6. Always use https for CORS_ORIGINS in production
