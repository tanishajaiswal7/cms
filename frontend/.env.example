# ==========================================
# Frontend Environment Variables
# ==========================================

# Backend API Configuration
VITE_BACKEND_URL=https://api.yourdomain.com

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key-here

# ==========================================
# IMPORTANT NOTES:
# ==========================================
# 1. Never commit your actual .env files to git
# 2. Create .env.development for local development
# 3. Create .env.production for production builds
# 4. Never expose SECRET keys in frontend environment variables
# 5. Only use PUBLISHABLE keys (pk_*) for Stripe on the frontend
# 6. Always use https URLs in production
